# E2E credentials — copy to `.env.e2e` (gitignored) and fill in. Read by playwright.e2e.config.ts.
# Use a DEDICATED test App ID, not a production one — the tests create and delete users/channels on it.

# Required. The App ID of a dedicated Sendbird test application.
E2E_APP_ID=
# Required. App-level Platform API token (NOT an org key). The tests use it to create/delete a
# throwaway user and channels per worker, so runs are isolated and safe to run in parallel — and
# concurrently across developers. Dashboard -> Settings -> Application -> API token.
E2E_PLATFORM_API_TOKEN=

# Optional: prefix for the per-worker throwaway users (default 'e2e').
# E2E_USER_PREFIX=e2e

# Optional: run against a deployed preview instead of the local apps/testing dev server.
# When set, Playwright does NOT start a dev server and hits this URL directly.
# E2E_BASE_URL=https://deploy-preview-123--<repo>.netlify.app

# Optional: override the local dev-server port (default 5173).
# E2E_PORT=5173
