# E2E credentials — copy to `.env.e2e` (gitignored) and fill in. Read by playwright.e2e.config.ts.
# Use a DEDICATED test App ID / accounts, not production ones.

E2E_APP_ID=
E2E_USER_ID=
# Optional: only if your App ID requires access tokens
E2E_ACCESS_TOKEN=
# Optional: second user for send/receive scenarios (ticket 4)
E2E_USER_ID_2=

# Recommended: app-level Platform API token (NOT an org key). Enables per-test channel/user creation
# and teardown so tests are isolated and safe to run in parallel — and concurrently across developers.
# Dashboard -> Settings -> Application -> API token. Without it, isolation/teardown is skipped.
E2E_PLATFORM_API_TOKEN=
# Optional: prefix for per-worker throwaway users (default 'e2e').
# E2E_USER_PREFIX=e2e

# Optional: run against a deployed preview instead of the local apps/testing dev server.
# When set, Playwright does NOT start a dev server and hits this URL directly.
# E2E_BASE_URL=https://deploy-preview-123--<repo>.netlify.app

# Optional: override the local dev-server port (default 5173).
# E2E_PORT=5173
